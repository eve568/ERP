NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>/<base_de_datos>?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:8081
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m

# Frontend Expo Web (se configura en frontend/.env.local o en Render)
EXPO_PUBLIC_API_URL=http://localhost:4000
