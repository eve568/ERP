{
  "expo": {
    "name": "ERP Modular",
    "slug": "erp-modular",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro"
    },
    "android": {
      "package": "com.erpmodular.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [],
      "allowBackup": false
    },
    "plugins": [
      "expo-secure-store"
    ],
    "userInterfaceStyle": "automatic"
  }
}
